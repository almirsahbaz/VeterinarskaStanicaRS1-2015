@model VeterinarskaStanica.Areas.ModulTehnickoOsoblje.Models.IzvrsenaUsluga
@{
    ViewBag.Title = "Dodavanje";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Dodavanje</h2>
<form asp-controller="IzvrsenaUsluga" asp-action="Create" data-ajax="True" method="Post" data-ajax-method="Post" data-ajax-url="IzvrsenaUsluga/Create">
    @*@using (Ajax.BeginForm("Create", "IzvrsenaUsluga", FormMethod.Post, new AjaxOptions { UpdateTargetId = "ajaxpozivKorisnici" }))*@
    {
        if (TempData["Message"] != null)
        {
            <div>
                <h3>@TempData["Message"]</h3>
            </div>
        }
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <h4>Izvršena usluga</h4>
            <hr />

            <div class="form-group">
                @Html.LabelFor(model => model.RacuniId, "Račun", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.RacuniId, Model.listaRacuna.Select(model => new SelectListItem
               {
                   Value = model.Id.ToString(),
                   Text = model.Naziv
               }).ToList(), new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.RacuniId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.UslugeId, "Usluga", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.UslugeId, Model.listaUsluga.Select(model => new SelectListItem
               {
                   Value = model.Id.ToString(),
                   Text = model.Naziv
               }).ToList(), new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.UslugeId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Dodaj" class="btn btn-default" />
                </div>
            </div>
        </div>
    }


   </form>